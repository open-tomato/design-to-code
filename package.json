{
  "name": "@open-tomato/design-to-code",
  "version": "0.0.0",
  "private": true,
  "description": "Design to code: from a design export to components with visual gates",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "d2c": "bun bin/d2c.ts",
    "check-types": "tsc --noEmit && tsc --noEmit -p templates/library",
    "build": "bun build ./bin/d2c.ts --target=bun --outdir=dist --external playwright --external playwright-core",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006 -c harness/.storybook",
    "build:storybook": "storybook build -c harness/.storybook",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "scripts/test-visual.sh",
    "test:visual:update": "scripts/test-visual.sh --update",
    "check:stories": "node scripts/check-stories.mjs",
    "setup": "playwright install chromium"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "parse5": "^8.0.1",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@storybook/test-runner": "^0.24.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4",
    "@types/bun": "latest",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/jest-image-snapshot": "^6.4.1",
    "@types/node": "^26.6.3",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "concurrently": "^10.0.3",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jest-image-snapshot": "^6.5.2",
    "jsonc-eslint-parser": "^3.3.0",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.6.1",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wait-on": "^9.0.10"
  },
  "trustedDependencies": [
    "@swc/core",
    "unrs-resolver"
  ],
  "overrides": {
    "playwright": "1.63.0",
    "playwright-core": "1.63.0"
  }
}
