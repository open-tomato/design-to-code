{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "design-to-code tool",
  "extends": "@open-tomato/typescript-config/react",
  "compilerOptions": {
    "module": "Preserve",
    "types": [
      "node",
      "bun"
    ],
    // The TypeScript sources import the tool's plain-ESM `.mjs` modules
    // (the lint rule, the story checker, the library ESLint config).
    "allowJs": true,
    // This tool is a CLI bundled by `bun build` and never emits
    // declarations. With `allowJs` above, isolatedDeclarations is refused
    // and the declaration checks fail on the inferred types of the `.mjs`
    // ESLint configs, so both are off.
    "declaration": false,
    "isolatedDeclarations": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "bin",
    "config",
    "harness",
    "harness/.storybook",
    "pipeline",
    "scripts",
    "*.ts",
    "*.mjs"
  ],
  "exclude": [
    "node_modules",
    "design",
    "components",
    "pipeline/gates/fixtures/**"
  ]
}
